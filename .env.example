# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg://anmol@localhost:5432/ideaforge

# LLM Provider (Groq default — get key at console.groq.com)
GROQ_API_KEY=gsk_...
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Alternative: Gemini (free tier, multimodal)
# GEMINI_API_KEY=...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Embeddings (fastembed local by default, no key needed)
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
